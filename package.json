{
  "name": "opsboard",
  "version": "0.1.0",
  "private": true,
  "description": "Administrative e-commerce operations platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@opsboard/web",
    "dev:api": "npm run start:dev --workspace=@opsboard/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
